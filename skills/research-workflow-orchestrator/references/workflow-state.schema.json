{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WenyuChiou/research-hub/schemas/research-workflow-state-1.1.json",
  "title": "Research workflow state 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow_id", "current_stage", "status", "updated_at",
    "trace_id", "correlation_id", "policy_checkpoint_ref", "policy_hash",
    "evidence_packet_refs", "actions", "decisions", "artifacts",
    "attempt_history", "pending_action", "pending_external_action",
    "external_write_ledger", "recovery_status", "migration_history", "blocker"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "workflow_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "current_stage": {"$ref": "#/$defs/stage"},
    "status": {"enum": ["running", "waiting_for_human", "completed", "blocked", "cancelled", "declined"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_checkpoint_ref": {"type": ["string", "null"], "maxLength": 2000},
    "policy_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "evidence_packet_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "attempt_history": {"type": "array", "items": {"$ref": "#/$defs/attemptHistory"}},
    "pending_action": {"oneOf": [{"$ref": "#/$defs/pendingAction"}, {"type": "null"}]},
    "pending_external_action": {"oneOf": [{"$ref": "#/$defs/pendingExternalAction"}, {"type": "null"}]},
    "external_write_ledger": {"type": "array", "items": {"$ref": "#/$defs/externalLedgerEntry"}},
    "recovery_status": {"enum": ["clean", "pending_external_action", "reconcile_required", "blocked", "recovered"]},
    "migration_history": {"type": "array", "items": {"$ref": "#/$defs/migration"}},
    "blocker": {"type": ["string", "null"], "maxLength": 2000}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "waiting_for_human"}}},
      "then": {
        "properties": {
          "pending_action": {
            "allOf": [
              {"$ref": "#/$defs/pendingAction"},
              {"properties": {"gate": {"$ref": "#/$defs/gate"}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["completed", "cancelled", "declined"]}}},
      "then": {
        "properties": {
          "pending_action": {"type": "null"},
          "pending_external_action": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "properties": {
          "current_stage": {"const": "release"},
          "decisions": {
            "contains": {
              "type": "object",
              "properties": {
                "gate": {"const": "release_authorization"},
                "outcome": {"const": "accept"},
                "authorization_source": {"enum": ["policy_checkpoint", "local_tty", "legacy_migration"]}
              },
              "required": ["gate", "outcome", "authorization_source"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}},
      "then": {
        "properties": {
          "decisions": {
            "contains": {
              "type": "object",
              "properties": {"outcome": {"const": "cancel"}},
              "required": ["outcome"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "declined"}}},
      "then": {
        "properties": {
          "decisions": {
            "contains": {
              "type": "object",
              "properties": {"outcome": {"const": "decline"}},
              "required": ["outcome"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"properties": {"blocker": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {
    "stage": {"enum": ["orient", "scope", "discover", "synthesize", "design", "execute", "write", "release"]},
    "gate": {"enum": ["scope_commitment", "external_write", "experiment_authorization", "semantic_revision", "release_authorization"]},
    "mode": {"enum": ["read_only", "preview", "write"]},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actionId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "started_at", "finished_at", "status", "outputs", "validation_result"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["success", "failed", "blocked", "cancelled"]},
        "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "validation_result": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action_hash", "stage", "tool", "mode", "scope", "input_hashes", "max_attempts", "validation_contract", "attempts"],
      "properties": {
        "action_id": {"$ref": "#/$defs/actionId"}, "action_hash": {"$ref": "#/$defs/hash"},
        "stage": {"$ref": "#/$defs/stage"}, "tool": {"type": "string", "minLength": 1, "maxLength": 200},
        "mode": {"$ref": "#/$defs/mode"}, "scope": {"$ref": "#/$defs/scope"},
        "input_hashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "validation_contract": {"type": "string", "minLength": 1, "maxLength": 2000},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "pendingAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action_hash", "gate", "tool", "mode", "scope", "input_hashes", "parameters_hash", "resource_bounds", "retry_count", "max_retries", "validation_contract"],
      "properties": {
        "action_id": {"$ref": "#/$defs/actionId"}, "action_hash": {"$ref": "#/$defs/hash"},
        "gate": {"oneOf": [{"$ref": "#/$defs/gate"}, {"type": "null"}]},
        "tool": {"type": "string", "minLength": 1, "maxLength": 200}, "mode": {"$ref": "#/$defs/mode"},
        "scope": {"$ref": "#/$defs/scope"}, "input_hashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "parameters_hash": {"$ref": "#/$defs/hash"},
        "resource_bounds": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
        "retry_count": {"type": "integer", "minimum": 0}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 9},
        "validation_contract": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action_hash", "gate", "outcome", "scope", "parameters_hash", "resource_bounds", "decided_at", "decided_by", "rationale", "authorization_source"],
      "properties": {
        "action_id": {"$ref": "#/$defs/actionId"}, "action_hash": {"$ref": "#/$defs/hash"},
        "gate": {"$ref": "#/$defs/gate"}, "outcome": {"enum": ["accept", "decline", "revise", "cancel"]},
        "scope": {"$ref": "#/$defs/scope"}, "parameters_hash": {"$ref": "#/$defs/hash"},
        "preview_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "resource_bounds": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "supersedes": {"type": ["string", "null"], "maxLength": 128},
        "decided_at": {"type": "string", "format": "date-time"},
        "decided_by": {"type": "string", "pattern": "^human:\\S+$", "maxLength": 200},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "authorization_source": {"enum": ["policy_checkpoint", "local_tty", "direct_human_stop", "legacy_migration"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "stage", "sha256", "created_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000}, "stage": {"$ref": "#/$defs/stage"},
        "sha256": {"$ref": "#/$defs/hash"}, "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "attemptHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["action_hash", "attempt", "status", "recorded_at"],
      "properties": {
        "action_hash": {"$ref": "#/$defs/hash"}, "attempt": {"type": "integer", "minimum": 1},
        "status": {"enum": ["started", "success", "failed", "blocked", "cancelled"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "pendingExternalAction": {
      "type": "object", "additionalProperties": true,
      "required": ["action_hash", "prepared_at"],
      "properties": {"action_hash": {"$ref": "#/$defs/hash"}, "prepared_at": {"type": "string", "format": "date-time"}}
    },
    "externalLedgerEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["action_hash", "result_ref", "completed_at"],
      "properties": {
        "action_hash": {"$ref": "#/$defs/hash"}, "result_ref": {"type": "string", "minLength": 1, "maxLength": 2000},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["from_version", "to_version", "migrated_at"],
      "properties": {
        "from_version": {"type": "string", "minLength": 1}, "to_version": {"type": "string", "minLength": 1},
        "migrated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
